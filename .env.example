# AcadSync settings — TEMPLATE for the team.
#
# 1. Copy this file and name the copy  .env   (same folder)
#      Windows:  copy .env.example .env
#      Mac/Linux: cp .env.example .env
# 2. Change the values in .env if you need to.
#
# .env is listed in .gitignore, so it never goes to GitHub. Keep real settings and anything
# secret in .env only; this example file is public and must stay free of secrets.

# local = shows error details while developing; production = shows only "Server error"
APP_ENV=local

# Timezone for deadlines, notifications and activities
APP_TIMEZONE=Asia/Manila

# Where the SQLite database file lives (relative to the project folder, or a full path).
# The file is created on the first request. data/*.db is in .gitignore: never commit it.
# For extra safety you can point this OUTSIDE the project, e.g. C:/acadsync-data/acadsync.db
DB_PATH=data/acadsync.db

# true = a brand-new database gets the demo section, demo accounts (password123) and sample data.
# Set to false for a real class, so the database starts empty.
SEED_DEMO_DATA=true

# "Forgot password" has no e-mail server yet, so the 6-digit code is shown on screen.
# It is only ever shown to a browser on the same computer as the server; set false to never show it.
SHOW_RESET_CODE=true

# true once the site is served over HTTPS (the login cookie is then only sent over HTTPS)
SESSION_SECURE_COOKIE=false
